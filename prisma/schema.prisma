// Emissor de Códigos de Patrimônio — SEOM / URE Suzano
//
// Regras estruturais que este schema precisa sustentar:
//   - sequencial é por trio (escola, classe, ANO), contador próprio a partir de 1
//   - o sequencial reinicia em 1 a cada ano; o ano faz parte do código, então
//     SUZ-BR20260001-TEC e SUZ-BR20270001-TEC são códigos distintos e nada é reaproveitado
//   - código nunca é reaproveitado: `cancelado` é só marcação, o número morre ocupado
//   - não existe tabela de contadores: o próximo sequencial vem de MAX() na transação
//   - não existe DELETE físico nem edição de código
//
// Sobre o MAX() no Postgres: aqui ele NÃO basta sozinho. O SQLite serializava escrita
// por natureza, então duas emissões simultâneas nunca liam o mesmo MAX(). O Postgres
// não faz isso — no isolamento padrão (READ COMMITTED) duas transações leem o mesmo
// MAX() e as duas seguem. Por isso a emissão pega um `pg_advisory_xact_lock` na chave
// (escola, classe, ano) ANTES de ler. Ver src/lib/emissao.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ONDE ESTAO AS CONNECTION STRINGS
//
// No Prisma 7 `url` e `directUrl` NAO existem mais neste arquivo - o schema nao aceita
// mais nenhuma das duas (P1012 se tentar). As URLs moram em dois lugares:
//
//   MIGRATIONS -> `prisma7.config.ts`, em `datasource.url`, que aponta para DIRECT_URL
//                 (porta 5432). Este e o equivalente Prisma 7 do antigo `directUrl`.
//
//   RUNTIME    -> a connection string do ADAPTER passado ao PrismaClient, em
//                 `src/lib/prisma.ts`. Sao dois clients:
//                   - DATABASE_URL, pooler porta 6543 (?pgbouncer=true), para o uso
//                     geral: na Vercel cada invocacao serverless abriria conexao nova
//                     e o Postgres estouraria o limite;
//                   - DIRECT_URL, porta 5432, EXCLUSIVO da transacao de emissao.
//
// A emissao precisa da conexao direta porque transacao interativa por pooler em
// transaction mode nao se sustenta: o pooler devolve a conexao ao pool entre
// statements, e o `pg_advisory_xact_lock` vive na transacao de UMA conexao. Se o
// statement seguinte cair em outro backend, o lock nao vale para ele - e a serializacao
// simplesmente nao acontece, sem erro nenhum. O sintoma seria codigo duplicado.
datasource db {
  provider = "postgresql"
}

model Escola {
  id        String   @id @default(uuid())
  sigla     String   @unique
  codigoCie String   @unique
  nome      String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  codigos   Codigo[]
  lotes     Lote[]
}

model Classe {
  id      String   @id @default(uuid())
  sigla   String   @unique
  nome    String
  ativa   Boolean  @default(true)

  codigos Codigo[]
  lotes   Lote[]
}

model Lote {
  id         String   @id @default(uuid())
  escolaId   String
  classeId   String
  // Ano do código emitido. Fica explícito e não derivado de `criadoEm`: uma emissão
  // na virada do ano precisa carregar o ano que foi de fato gravado no código.
  ano        Int
  quantidade Int
  descricao  String
  emitidoPor String
  criadoEm   DateTime @default(now())

  escola     Escola   @relation(fields: [escolaId], references: [id])
  classe     Classe   @relation(fields: [classeId], references: [id])
  codigos    Codigo[]

  @@index([escolaId, classeId])
  @@index([criadoEm])
}

model Codigo {
  id         String   @id @default(uuid())
  codigo     String   @unique
  escolaId   String
  classeId   String
  ano        Int
  sequencial Int
  loteId     String
  cancelado  Boolean  @default(false)
  criadoEm   DateTime @default(now())

  escola     Escola   @relation(fields: [escolaId], references: [id])
  classe     Classe   @relation(fields: [classeId], references: [id])
  lote       Lote     @relation(fields: [loteId], references: [id])

  // Rede de segurança: mesmo que a lógica falhe, o banco recusa sequencial repetido
  // dentro do trio (escola, classe, ano).
  @@unique([escolaId, classeId, ano, sequencial])

  // Consulta e exportação filtram por ano com frequência.
  @@index([ano])
}
