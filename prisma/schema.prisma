// Emissor de Códigos de Patrimônio — SEOM / URE Suzano
//
// Regras estruturais que este schema precisa sustentar:
//   - sequencial é por trio (escola, classe, ANO), contador próprio a partir de 1
//   - o sequencial reinicia em 1 a cada ano; o ano faz parte do código, então
//     BRA-202600001-TEC e BRA-202700001-TEC são códigos distintos e nada é reaproveitado
//   - código nunca é reaproveitado: `cancelado` é só marcação, o número morre ocupado
//   - não existe tabela de contadores: o próximo sequencial vem de MAX() na transação
//   - não existe DELETE físico nem edição de código

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Escola {
  id        String   @id @default(uuid())
  sigla     String   @unique
  codigoCie String   @unique
  nome      String
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  codigos   Codigo[]
  lotes     Lote[]
}

model Classe {
  id      String   @id @default(uuid())
  sigla   String   @unique
  nome    String
  ativa   Boolean  @default(true)

  codigos Codigo[]
  lotes   Lote[]
}

model Lote {
  id         String   @id @default(uuid())
  escolaId   String
  classeId   String
  // Ano do código emitido. Fica explícito e não derivado de `criadoEm`: uma emissão
  // na virada do ano precisa carregar o ano que foi de fato gravado no código.
  ano        Int
  quantidade Int
  descricao  String
  emitidoPor String
  criadoEm   DateTime @default(now())

  escola     Escola   @relation(fields: [escolaId], references: [id])
  classe     Classe   @relation(fields: [classeId], references: [id])
  codigos    Codigo[]

  @@index([escolaId, classeId])
  @@index([criadoEm])
}

model Codigo {
  id         String   @id @default(uuid())
  codigo     String   @unique
  escolaId   String
  classeId   String
  ano        Int
  sequencial Int
  loteId     String
  cancelado  Boolean  @default(false)
  criadoEm   DateTime @default(now())

  escola     Escola   @relation(fields: [escolaId], references: [id])
  classe     Classe   @relation(fields: [classeId], references: [id])
  lote       Lote     @relation(fields: [loteId], references: [id])

  // Rede de segurança: mesmo que a lógica falhe, o banco recusa sequencial repetido
  // dentro do trio (escola, classe, ano).
  @@unique([escolaId, classeId, ano, sequencial])

  // Consulta e exportação filtram por ano com frequência.
  @@index([ano])
}
