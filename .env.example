# ---------------------------------------------------------------------------
# Banco: Supabase Postgres, pelo POOLER nas duas portas.
#
# O usuario e `emissor.<ref>`, NAO `postgres.<ref>`. O papel `emissor` e proprio
# deste projeto: o banco e compartilhado com outro sistema, e rotacionar a senha
# do postgres derrubaria os dois. Crie o papel com: npm run papel:criar
#
# NAO use o host `db.<ref>.supabase.co`: em projeto novo ele e IPv6 apenas, e
# maquina sem rota IPv6 recebe ENETUNREACH. IPv4 direto e add-on pago.
# ---------------------------------------------------------------------------

# Session pooler, porta 5432. Sustenta transacao interativa e advisory lock.
# Usado por: migrations, seed, scripts, testes e A TRANSACAO DE EMISSAO.
DIRECT_URL="postgresql://emissor.SEU_REF:SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres"

# Transaction pooler, porta 6543. Runtime da aplicacao (Vercel).
DATABASE_URL="postgresql://emissor.SEU_REF:SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---------------------------------------------------------------------------
# TLS: a CA do Supabase, em CONTEUDO PEM (nao caminho de arquivo).
#
# Sem ela a aplicacao FALHA de proposito. A alternativa seria sslmode=no-verify,
# que criptografa mas aceita qualquer certificado - nao protege contra alguem no
# meio do caminho.
#
# Painel: Settings > Database > SSL Configuration > Download certificate.
# Cole o PEM numa linha so, com \n no lugar das quebras.
# ---------------------------------------------------------------------------
SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
