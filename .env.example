# ---------------------------------------------------------------------------
# Banco: Supabase Postgres. As DUAS strings sao necessarias e diferentes.
# Painel do Supabase > Project Settings > Database > Connection string.
# ---------------------------------------------------------------------------

# Pooler, porta 6543. Usado em runtime pela aplicacao (Vercel).
# Serverless abre muita conexao; o pooler existe para absorver isso.
DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexao DIRETA, porta 5432. Usada por:
#   - migrations (prisma7.config.ts)
#   - a transacao de emissao (advisory lock nao sobrevive ao pooler)
#   - os testes, o seed e os scripts de linha de comando
DIRECT_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Autenticacao: Supabase Auth. Painel > Project Settings > API.
# Estas duas vao para o navegador (NEXT_PUBLIC_). Nao ha segredo nelas: quem
# autoriza e a sessao do usuario, e as tabelas estao fechadas por RLS.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://SEU_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"
